# Copy to .env and replace every value before running docker compose.
MYSQL_DATABASE=les_deux_colombes
MYSQL_USER=resto_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Ports bound on localhost (put a TLS reverse proxy in front in production).
API_PORT=8080
PUBLIC_PORT=8081
ADMIN_PORT=8082

# Generate with: openssl rand -base64 48
JWT_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=LesDeuxColombesApi
JWT_AUDIENCE=LesDeuxColombesClient

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
DEEPL_API_KEY=replace-me

FRONTEND_URL=https://www.example.com
PUBLIC_ORIGIN=https://www.example.com
ADMIN_ORIGIN=https://admin.example.com
API_HOST=api.example.com

# Frontend builds (use the public URLs of the deployed API and admin service).
VITE_API_URL=https://restaurant-sxxt.onrender.com
VITE_ADMIN_API_URL=https://restaurant-sxxt.onrender.com
VITE_ADMIN_URL=https://your-admin.example.com